{
  "name": "datagouv-mcp",
  "version": "1.0.0-alpha.0",
  "description": "MCP server for data.gouv.fr: search, inspect and query any open dataset of the French national open data platform.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "bin": {
    "datagouv-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts --http",
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:layers": "tsx scripts/check-layers.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "RUN_LIVE_TESTS=1 vitest run tests/live",
    "evidence": "tsx scripts/evidence.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:layers && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "4.13.5",
    "lru-cache": "11.5.2",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.0.0",
    "tsdown": "0.21.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "undici": "8.10.1",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
