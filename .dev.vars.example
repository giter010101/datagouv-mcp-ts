# Copy to .dev.vars (gitignored). Names only — fill values locally.
# Wrangler reads .dev.vars for `wrangler dev`. Node MCP also reads process.env
# (copy the same names into .env if you run `node dist/index.js` without wrangler).
# Never commit .dev.vars, .env, or wrangler OAuth tokens.

# --- Transport ---
MCP_TRANSPORT=
MCP_HOST=
MCP_PORT=
MCP_ENV=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# --- Upstream ---
DATAGOUV_API_ENV=

# --- Logging ---
LOG_LEVEL=

# --- HTTP client ---
HTTP_TIMEOUT_MS=
HTTP_RETRIES=
MAX_DOWNLOAD_BYTES=

# --- Cache / output ---
CACHE_MAX_ENTRIES=
CACHE_DEFAULT_TTL_MS=
MAX_OUTPUT_CHARS=

# --- Optional engine ---
ENABLE_DUCKDB=

# --- Optional telemetry (secrets: use wrangler secret put in production) ---
MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_AUTH_TOKEN=
SENTRY_DSN=
SENTRY_SAMPLE_RATE=
