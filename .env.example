# --- Transport ---------------------------------------------------------------
# stdio (default) or http. CLI flag --http overrides.
MCP_TRANSPORT=stdio
# HTTP transport bind address / port (legacy-compatible names).
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Deployment name reported by /health and sent to Sentry.
MCP_ENV=local

# --- Upstream data.gouv.fr environment ----------------------------------------
# prod or demo (selects API base URLs; metrics API is always prod).
DATAGOUV_API_ENV=prod

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace (legacy uppercase values accepted).
LOG_LEVEL=info

# --- HTTP client -------------------------------------------------------------
# Default timeout for upstream calls (ms) and number of retries on 429/5xx/network errors.
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
# Max bytes the server will download from a resource URL for in-process parsing.
MAX_DOWNLOAD_BYTES=52428800

# --- Cache -------------------------------------------------------------------
CACHE_MAX_ENTRIES=500
CACHE_DEFAULT_TTL_MS=300000

# --- Output shaping ------------------------------------------------------------
# Soft cap on the text content returned by one tool call (characters).
MAX_OUTPUT_CHARS=40000

# --- Optional engines ----------------------------------------------------------
# Set to 1 to enable the DuckDB query engine (requires @duckdb/node-api installed).
ENABLE_DUCKDB=0

# --- Optional telemetry (disabled when unset) ----------------------------------
# MATOMO_URL=https://matomo.example.org
# MATOMO_SITE_ID=1
# MATOMO_AUTH_TOKEN=
# SENTRY_DSN=
# SENTRY_SAMPLE_RATE=1.0
